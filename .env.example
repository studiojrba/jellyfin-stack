# Copy to .env and fill in your real value(s). .env is gitignored.
# Used by docker-compose.yml (onepace-maintenance) and the stack keeper.

# TorBox API key. Powers decypharr's debrid mount and the One Pace re-add loop.
# Get it from https://torbox.app -> Settings -> API.
TORBOX_KEY=your-torbox-api-key-here

# Jellyfin API key. Lets the stack keeper trigger a library rescan after it heals
# the mount or rebuilds symlinks. Generate it AFTER first boot in the Jellyfin UI:
# Dashboard -> API Keys -> +. Leave blank until then; the keeper just skips the
# rescan step if it's unset.
JELLYFIN_API_KEY=your-jellyfin-api-key-here
