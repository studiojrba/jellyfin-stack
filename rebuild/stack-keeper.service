[Unit]
Description=jellyfin-stack keeper (mount health + symlink health + jellyfin rescan)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# The user and repo path below are filled in by rebuild/install-keeper.sh at install time.
User=__USER__
WorkingDirectory=__REPO__
ExecStart=/usr/bin/env bash __REPO__/rebuild/stack_keeper.sh
